+    async def search(self, query, **kwargs):
+        return SearchResult(query=query, outcome=self.outcome,
+                            error="Provider unavailable" if self.outcome not in (SearchOutcome.SUCCESS, SearchOutcome.ZERO_RESULTS) else None)
