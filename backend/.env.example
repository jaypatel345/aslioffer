# AsliOffer Backend Environment Configuration
PROJECT_NAME="AsliOffer Backend"
ENVIRONMENT="development"
DEBUG=true

# Database (Postgres in Docker, SQLite for instant zero-dependency local dev)
DATABASE_URL="sqlite:///./aslioffer.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aslioffer"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# SerpApi Key (Live Google Knowledge & Public Footprint verification)
# Get key at https://serpapi.com - If blank, mock engine is used
SERPAPI_API_KEY=""

# Google Gemini API Key (Gemini 2.5 Flash for multimodal document OCR and synthesis)
# Get key at https://aistudio.google.com - If blank, mock engine is used
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
