# AsliOffer Backend Environment Configuration
PROJECT_NAME="AsliOffer Backend"
ENVIRONMENT="development"
DEBUG=true

# Database (Postgres in Docker, SQLite for instant zero-dependency local dev)
DATABASE_URL="sqlite:///./aslioffer.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aslioffer"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# SerpApi Key (Live Google Knowledge & Public Footprint verification)
# Get key at https://serpapi.com - If blank, searches fail and reports say so (no mock data)
SERPAPI_API_KEY=""

# Document reading for screenshots/scanned PDFs: Groq is tried first, then Gemini.
# Without either key, paste text instead (text PDFs are read locally).
# Check the configured models answer: python -m app.core.provider_check
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Run service and privacy controls
RUN_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=5242880
MAX_TEXT_CHARS=20000
# Uploaded cases and their reports are deleted this many days after upload.
CASE_RETENTION_DAYS=7

