# AsliOffer Monorepo Environment Variables
# SerpApi Key (Live Google search, Google Jobs, knowledge graph checks)
SERPAPI_API_KEY=""

# Google Gemini API Key (Gemini 2.5 Flash for multimodal document OCR and synthesis)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aslioffer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aslioffer"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
