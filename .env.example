# AsliOffer Monorepo Environment Variables
# SerpApi Key (Live Google search, Google Jobs, knowledge graph checks)
SERPAPI_API_KEY=""
SEARCH_TIMEOUT_SECONDS=8.0
SEARCH_MAX_RETRIES=2
SEARCH_RETRY_BACKOFF_SECONDS=0.5
SEARCH_DEMO_MODE=false

# Google Gemini API Key (Gemini 2.5 Flash for multimodal document OCR and synthesis)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aslioffer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aslioffer"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
