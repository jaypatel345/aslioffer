# AsliOffer Monorepo Environment Variables
# SerpApi Key (Live Google search, Google Jobs, knowledge graph checks)
SERPAPI_API_KEY=""
SEARCH_TIMEOUT_SECONDS=60.0
SEARCH_MAX_RETRIES=2
SEARCH_RETRY_BACKOFF_SECONDS=0.5
SEARCH_TOTAL_TIMEOUT_SECONDS=65.0
SEARCH_DEMO_MODE=false
SEARCH_COUNTRY=in
SEARCH_LANGUAGE=en
SEARCH_GOOGLE_DOMAIN=google.co.in
INVESTIGATION_SEARCH_DEADLINE_SECONDS=90
INVESTIGATION_MAX_SEARCHES=12
INVESTIGATION_MAX_CONCURRENT_SEARCHES=5

# Document reading for screenshots/scanned PDFs: Groq is tried first, then Gemini.
# Check the configured models answer: cd backend && python -m app.core.provider_check
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aslioffer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aslioffer"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"

# Run service and privacy controls
RUN_TIMEOUT_SECONDS=150
MAX_UPLOAD_BYTES=5242880
MAX_TEXT_CHARS=20000
# Uploaded cases and their reports are deleted this many days after upload.
CASE_RETENTION_DAYS=7
